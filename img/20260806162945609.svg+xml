<svg xmlns="http://www.w3.org/2000/svg" width="1080" height="260" viewBox="0 0 1080 260" role="img" aria-labelledby="title desc">
  <title id="title">Geohash 围栏配置预处理流程</title>
  <desc id="desc">从多边形顶点到 Geohash 前缀与后缀集合的处理流程</desc>
  <defs>
    <marker id="arrow" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto" markerUnits="strokeWidth">
      <path d="M0,0 L0,6 L9,3 z" fill="#64748b"/>
    </marker>
    <style>
      .bg { fill: #f7f9fb; }
      .box { fill: #ffffff; stroke-width: 2; rx: 14; }
      .line { stroke: #64748b; stroke-width: 2; marker-end: url(#arrow); }
      .h { font: 600 16px "Microsoft YaHei", "Noto Sans CJK SC", Arial, sans-serif; fill: #172033; text-anchor: middle; }
      .t { font: 13px "Microsoft YaHei", "Noto Sans CJK SC", Arial, sans-serif; fill: #475569; text-anchor: middle; }
      .cap { font: 600 18px "Microsoft YaHei", "Noto Sans CJK SC", Arial, sans-serif; fill: #172033; }
    </style>
  </defs>
  <rect class="bg" width="1080" height="260" rx="18"/>
  <text class="cap" x="40" y="42">Geohash 围栏配置预处理</text>
  <line class="line" x1="210" y1="137" x2="250" y2="137"/>
  <line class="line" x1="410" y1="137" x2="450" y2="137"/>
  <line class="line" x1="610" y1="137" x2="650" y2="137"/>
  <line class="line" x1="810" y1="137" x2="850" y2="137"/>
  <rect class="box" x="42" y="88" width="168" height="98" stroke="#2563eb"/>
  <text class="h" x="126" y="124">输入围栏顶点</text>
  <text class="t" x="126" y="150">有序经纬度点</text>
  <text class="t" x="126" y="170">至少 3 个</text>
  <rect class="box" x="250" y="88" width="160" height="98" stroke="#0891b2"/>
  <text class="h" x="330" y="124">校验与外接矩形</text>
  <text class="t" x="330" y="150">坐标范围校验</text>
  <text class="t" x="330" y="170">确定扫描边界</text>
  <rect class="box" x="450" y="88" width="160" height="98" stroke="#7c3aed"/>
  <text class="h" x="530" y="124">扫描相交网格</text>
  <text class="t" x="530" y="150">顶点、角点、边</text>
  <text class="t" x="530" y="170">任一重叠即保留</text>
  <rect class="box" x="650" y="88" width="160" height="98" stroke="#d97706"/>
  <text class="h" x="730" y="124">生成完整哈希</text>
  <text class="t" x="730" y="150">中心点编码</text>
  <text class="t" x="730" y="170">去重并检查容量</text>
  <rect class="box" x="850" y="88" width="188" height="98" stroke="#059669"/>
  <text class="h" x="944" y="118">压缩并保存</text>
  <text class="t" x="944" y="144">32 子网格合父网格</text>
  <text class="t" x="944" y="166">公共前缀 + 后缀</text>
</svg>

